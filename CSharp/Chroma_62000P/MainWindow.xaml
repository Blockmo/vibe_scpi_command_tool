<Window x:Class="Chroma62000P.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chroma 62000P Control Panel"
        Width="1340" Height="900" MinWidth="1140" MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid Margin="26,18,26,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======================= Header ======================= -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="46" Height="46" CornerRadius="13" Background="{DynamicResource LogoGradient}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE945;" FontSize="22"
                                   Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Chroma 62000P" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="23" FontWeight="SemiBold"/>
                            <Border x:Name="SimBadge" Visibility="Collapsed" Background="{DynamicResource AmberDim}" CornerRadius="6"
                                    Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SimBadgeText" Foreground="{DynamicResource Amber}" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="999" Padding="3,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeIcon" Style="{StaticResource Icon}" Text="&#xE790;" Foreground="{DynamicResource Muted}" Margin="10,0,6,0"/>
                            <StackPanel x:Name="ThemeSwatches" Orientation="Horizontal" Margin="0,0,3,0"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="10,0,0,0" Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" Foreground="{DynamicResource Muted}" Margin="10,0,6,0"/>
                            <RadioButton x:Name="LangEn" Style="{StaticResource LangSeg}" GroupName="lang" Content="EN"
                                         IsChecked="True" Checked="Lang_Checked"/>
                            <RadioButton x:Name="LangZh" Style="{StaticResource LangSeg}" GroupName="lang" Content="繁中"
                                         Checked="Lang_Checked"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ======================= Connection ======================= -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,14" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0" MinWidth="96">
                        <TextBlock x:Name="ConnLabel" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock x:Name="VisaLabel" Foreground="{DynamicResource Faint}" FontSize="11.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="ResourceCombo" Grid.Column="1" IsEditable="True" Text="GPIB0::9::INSTR"/>
                    <Button x:Name="ScanBtn" Grid.Column="2" Margin="10,0,0,0" Click="Scan_Click" MinWidth="100">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ScanIcon" Style="{StaticResource Icon}" Text="&#xE721;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ScanText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConnectBtn" Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource PrimaryButton}"
                            MinWidth="140" Click="Connect_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ConnectIcon" Style="{StaticResource Icon}" Text="&#xE71B;" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ConnectText" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="StatusPill" Grid.Column="4" Margin="16,0,0,0" CornerRadius="999" Padding="14,8"
                            Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" MaxWidth="440" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource Faint}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Margin="9,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ======================= Content ======================= -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 指令瀏覽 -->
                <Border Style="{StaticResource Card}" Padding="16,18,10,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="4,0,6,10">
                            <TextBlock x:Name="CommandsLabel" Style="{StaticResource SectionLabel}" Margin="0"/>
                            <TextBlock x:Name="CountText" HorizontalAlignment="Right" Foreground="{DynamicResource Faint}" FontSize="11.5"/>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,6,12">
                            <TextBox x:Name="SearchBox" Padding="34,0,32,0" TextChanged="Search_TextChanged"
                                     PreviewKeyDown="Search_PreviewKeyDown"/>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{DynamicResource Faint}"
                                       Margin="13,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                            <Button x:Name="ClearSearchBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                                    Width="30" Height="30" Padding="0" Margin="0,0,4,0" Visibility="Collapsed"
                                    Click="ClearSearch_Click">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="10"/>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,0,6,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="GroupLabel" Foreground="{DynamicResource Muted}" FontSize="12.5"
                                       VerticalAlignment="Center" Margin="4,0,12,0"/>
                            <ComboBox x:Name="GroupCombo" Grid.Column="1" SelectionChanged="GroupCombo_SelectionChanged"/>
                        </Grid>

                        <Grid Grid.Row="3">
                            <ListBox x:Name="CommandList" ItemContainerStyle="{StaticResource CommandItem}"
                                     SelectionChanged="CommandList_SelectionChanged" Padding="0,0,6,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Desc}" Foreground="{DynamicResource Muted}" FontSize="11.5"
                                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{DynamicResource Surface3}" CornerRadius="5"
                                                    Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding AccessBadge}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Muted}" FontFamily="{StaticResource MonoFont}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="28" Foreground="{DynamicResource Faint}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="EmptyText" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 右側 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="*" MinHeight="150"/>
                    </Grid.RowDefinitions>

                    <!-- 指令詳情（左右兩欄） -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24,18">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CmdName" FontFamily="{StaticResource MonoFont}" FontSize="23" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Tag}" Background="{DynamicResource AccentDim}">
                                        <TextBlock x:Name="GroupTag" Foreground="{DynamicResource Accent}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Style="{StaticResource Tag}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE736;" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="PageTag" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Tag}" Margin="0">
                                        <TextBlock x:Name="AccessTag" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="CmdDesc" Foreground="{DynamicResource Muted}" FontSize="13.5" TextWrapping="Wrap" Margin="0,4,0,0"/>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="SyntaxLabel" Style="{StaticResource SectionLabel}"/>
                                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="14,9">
                                        <TextBlock x:Name="CmdSyntax" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                   Foreground="{DynamicResource Sky}" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock x:Name="ParamLabel" Style="{StaticResource SectionLabel}" Margin="0,14,0,8"/>
                                    <ContentControl x:Name="ParamHost" Focusable="False"/>
                                    <TextBlock x:Name="ParamHint" Foreground="{DynamicResource Faint}" FontSize="11.5"
                                               TextWrapping="Wrap" Margin="2,6,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="PreviewLabel" Style="{StaticResource SectionLabel}"/>
                                    <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="9" Padding="14,9">
                                        <StackPanel>
                                            <Grid x:Name="PreviewWriteRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="W" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}" FontWeight="Bold"/>
                                                <TextBlock x:Name="PreviewWrite" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"/>
                                            </Grid>
                                            <Grid x:Name="PreviewReadRow" Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="R" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Sky}" FontWeight="Bold"/>
                                                <TextBlock x:Name="PreviewRead" Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="12.5" TextWrapping="Wrap"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <UniformGrid Columns="3" Margin="0,16,0,0">
                                        <Button x:Name="WriteBtn" Style="{StaticResource PrimaryButton}" Padding="8,0" Margin="0,0,5,0" Click="Write_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE724;" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="WriteText" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="ReadBtn" Style="{StaticResource OutlineButton}" Padding="8,0" Margin="5,0" Click="Read_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ReadText" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="CopyBtn" Padding="8,0" Margin="5,0,0,0" Click="Copy_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="CopyText" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 主控台 -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,14,12,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,8,8">
                                <TextBlock x:Name="ConsoleLabel" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
                                <Button x:Name="ClearBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Click="ClearLog_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="ClearText" VerticalAlignment="Center" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Grid.Row="1" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="9" Padding="14,9" Margin="0,0,8,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LastRespLabel" Foreground="{DynamicResource Faint}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBox x:Name="LastResp" Grid.Column="1" IsReadOnly="True" Height="Auto" Padding="0"
                                             Background="Transparent" BorderThickness="0" FontFamily="{StaticResource MonoFont}"
                                             FontSize="15" Foreground="{DynamicResource Success}" Text="—"/>
                                </Grid>
                            </Border>
                            <ListBox x:Name="LogList" Grid.Row="2" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                     VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter Margin="0,2"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{DynamicResource Faint}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Tag}" Foreground="{Binding Brush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Text}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ======================= Footer ======================= -->
            <Grid Grid.Row="3" Margin="2,12,2,0">
                <TextBlock x:Name="FooterText" Foreground="{DynamicResource Faint}" FontSize="11.5"/>
                <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource Faint}" FontSize="11.5"
                           Text="Source: Chroma 62000P Operating &amp; Programming Manual · Ch.5 Remote Operation"/>
            </Grid>
        </Grid>

        <!-- ======================= Toast ======================= -->
        <Border x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,46"
                Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource BorderHi}" BorderThickness="1"
                CornerRadius="10" Padding="16,10" Opacity="0" IsHitTestVisible="False" Effect="{DynamicResource CardShadow}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{DynamicResource Success}" Margin="0,0,10,0"/>
                <TextBlock x:Name="ToastText" FontSize="13" MaxWidth="700" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
