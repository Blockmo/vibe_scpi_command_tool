<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ScpiAllInOne</RootNamespace>
    <AssemblyName>SCT</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>SCPI Command Tool</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- 視窗左上角 / 工作列圖示（由 tools/make_icon.py 產生） -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 各儀器的指令表，內嵌進 exe（資源名稱 = 檔名，如 DAQ973A.json） -->
    <EmbeddedResource Include="Data\*.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
